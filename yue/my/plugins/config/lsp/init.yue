pid = vim.fn.getpid()

servers =
  jsonls:
    settings:
      json:
        schemas: require'schemastore'.json.schemas()
        validate: enable: true
  eslint:
    settings:
      validate: 'on'
      format: true
  omnisharp:
    handlers:
      ['textDocument/definition']: require'omnisharp_extended'.definition_handler
    cmd: { 'OmniSharp', '--languageserver', '--hostPID', tostring(pid), '--encoding', 'utf-16' }

lsp_signature_cfg =
  bind: true
  handler_opts:
    border: 'rounded'

export default ->
  require'lsp_signature'.setup lsp_signature_cfg

  -- Shared defaults for every server
  vim.lsp.config '*',
    capabilities: require'cmp_nvim_lsp'.default_capabilities()
    flags:
      debounce_text_changes: 150

  -- Per-server overrides (merged with nvim-lspconfig defaults)
  for name, cfg in pairs servers
    vim.lsp.config name, cfg

  require('my.plugins.config.lsp.installer').setup(servers)
