export default ->
  telescope = require 'telescope'

  telescope.setup
    defaults:
      file_ignore_patterns: { 'node_modules' }
      vimgrep_arguments:
        * 'rg'
        * '--color=never'
        * '--no-heading'
        * '--with-filename'
        * '--line-number'
        * '--column'
        * '--smart-case'
        * '--hidden'
        * '--glob=!**/.git/*'
    pickers:
      find_files:
        find_command: { 'rg', '--files', '--hidden', '--glob=!**/.git/*' }

  pcall telescope.load_extension, 'dap'
