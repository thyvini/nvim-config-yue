export default ->
  local port = os.getenv 'GDScript_Port' or '6005'
  local cmd = vim.lsp.rpc.connect('127.0.0.1', tonumber(port))
  local root_markers = { 'project.godot', '.git' }

  vim.lsp.start {
    name: 'Godot',
    cmd: cmd,
    filetypes:
      * 'gd'
      * 'gdscript'
    root_dir: vim.fs.dirname(vim.fs.find({ 'project.godot', '.git' }, { upward: true })[1])
  }
